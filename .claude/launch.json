{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vsl-api",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "src.app.server",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "vsl-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd external/vsl-web && exec npm run dev -- --port 3000"
      ],
      "port": 3000
    },
    {
      "name": "vsl-web-lan",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd external/vsl-web && exec npm run dev:lan"
      ],
      "port": 3000,
      "url": "https://localhost:3000"
    }
  ]
}
